; Minimal Android preset. The reliable way is Project > Export > Add... > Android in the editor, which
; writes export_presets.cfg for you; the values below are the ones that matter for this project.
[preset.0]

name="Android"
platform="Android"
runnable=true
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="build/GameSpace.apk"

[preset.0.options]

gradle_build/use_gradle_build=false
gradle_build/min_sdk=""
gradle_build/target_sdk=""
architectures/arm64-v8a=true
architectures/armeabi-v7a=false
architectures/x86=false
architectures/x86_64=false
version/code=1
version/name="1.0"
package/unique_name="com.example.gamespace"
package/name="Game Space"
screen/immersive_mode=true
screen/support_small=true
screen/support_normal=true
screen/support_large=true
screen/support_xlarge=true
graphics/opengl_debug=false
permissions/internet=true
